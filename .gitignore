# Root .gitignore
# Node
node_modules/
website/node_modules/
# Composer
vendor/
# Python
__pycache__/
*.pyc
# Flutter/Dart
.dart_tool/
build/
# IDEs
.vscode/
.idea/
# OS
.DS_Store
Thumbs.db
# Logs
*.log
# Env
.env
.env.*
# Misc
*.swp
*.swo
# Coverage
coverage/

# Website generated artifacts
website/.cache/
website/.parcel-cache/
website/dist/
website/build/
# Laravel
storage/
bootstrap/cache/
/public/hot
/public/storage
/public/mix-manifest.json
/public/css/app.css
/public/js/app.js
!website/bootstrap/cache/
!website/bootstrap/cache/.gitignore
!website/storage/
!website/storage/framework/
!website/storage/framework/cache/
!website/storage/framework/cache/.gitignore
!website/storage/framework/cache/data/
!website/storage/framework/cache/data/.gitignore
!website/storage/framework/sessions/
!website/storage/framework/sessions/.gitignore
!website/storage/framework/views/
!website/storage/framework/views/.gitignore
!website/storage/logs/
!website/storage/logs/.gitignore
# Docker
*.pid

!backend/.env.text

#ignore Agents for the development
_bmad/
.claude/
.gemini/
