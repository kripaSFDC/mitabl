APP_ENV=staging
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SERVICE=backend-api

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mitabl
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
HORIZON_PREFIX=mitabl_horizon:
CACHE_DRIVER=redis
SESSION_DRIVER=file

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Never commit plaintext credentials to git.

GOOGLE_MAPS_API_KEY=


RUN_MIGRATIONS_ON_BOOT=false
RUN_SEEDERS_ON_BOOT=false
ADMIN_TEST_USERS_ENABLED=true
ADMIN_TEST_USERS_PASSWORD=
ADMIN_TEST_USERS_OVERRIDE_EXISTING=false
ADMIN_TEST_USERS_EMAIL_DOMAIN=example.com
