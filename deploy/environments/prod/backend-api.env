APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SERVICE=backend-api

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_DB_HOST
DB_PORT=3306
DB_DATABASE=mitabl
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
HORIZON_PREFIX=mitabl_horizon:
CACHE_DRIVER=redis
SESSION_DRIVER=file

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Never commit plaintext credentials to git.

RUN_MIGRATIONS_ON_BOOT=false
RUN_SEEDERS_ON_BOOT=false
