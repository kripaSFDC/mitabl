APP_NAME=mitabl
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_SERVICE=backend
APP_KEY=base64:REPLACE_WITH_BASE64_32_BYTE_KEY

JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET
JWT_TTL=null
JWT_REFRESH_TTL=null

# One-time bootstrap admin (only used in production when RUN_SEEDERS_ON_BOOT=true)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mitabl
DB_USERNAME=root
DB_PASSWORD=REPLACE_WITH_DB_ROOT_PASSWORD

QUEUE_CONNECTION=redis
HORIZON_PREFIX=mitabl_horizon:
CACHE_DRIVER=redis
SESSION_DRIVER=file

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set to true ONLY for first boot on a fresh database, then set back to false.
RUN_MIGRATIONS_ON_BOOT=false
RUN_SEEDERS_ON_BOOT=false
# Roles and permissions are always re-seeded on boot (idempotent). Set to false only to explicitly skip.
RUN_PERMISSION_SEED_ON_BOOT=true
