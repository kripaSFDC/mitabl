# These should true on the first deployment (fresh DB has no schema yet). After initial setup, leave it false and run migrations as a deliberate step (php artisan migrate).
RUN_SEEDERS_ON_BOOT=true
RUN_MIGRATIONS_ON_BOOT=true
# Roles and permissions are always re-seeded on boot (idempotent). Set to false only to explicitly skip.
RUN_PERMISSION_SEED_ON_BOOT=true
