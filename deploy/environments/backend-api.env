# Never commit plaintext credentials to git.
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_REDIRECT_URI=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
GOOGLE_MAPS_API_KEY=


SUPPORT_MOBCONTACT_ALIAS_SUNSET=2026-12-31
SUPPORT_MOBCONTACT_ALIAS_REPLACEMENT_PATH=/api/support/ticket

RUN_MIGRATIONS_ON_BOOT=false
RUN_SEEDERS_ON_BOOT=false
