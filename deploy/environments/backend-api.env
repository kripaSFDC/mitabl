APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SERVICE=backend-api

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mitabl
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
HORIZON_PREFIX=mitabl_horizon:
CACHE_DRIVER=redis
SESSION_DRIVER=file

REDIS_HOST=redis
REDIS_PASSWORD=null
