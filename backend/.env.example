APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
PERMISSION_CACHE_STORE=
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
HORIZON_PREFIX=mitabl_horizon:
HORIZON_PATH=horizon
SESSION_DRIVER=file

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAIL_SUBJECT="Testing Application OTP"

JWT_SECRET=
JWT_TTL=null
JWT_REFRESH_TTL=null

# Boot-time automation flags
# Set true only on first deploy (fresh DB) or deliberate re-seed.
# Leave false for normal restarts — run migrations manually instead.
RUN_MIGRATIONS_ON_BOOT=false
RUN_SEEDERS_ON_BOOT=false

# Mobile App Version Gate
# Bump APP_VERSION_MINIMUM to force a hard upgrade in the mobile app.
# Bump APP_VERSION_LATEST to show an optional "update available" prompt.
APP_VERSION_MINIMUM=1.0.0
APP_VERSION_LATEST=1.0.0
APP_VERSION_IOS_URL=https://apps.apple.com/app/mitabl/id0000000000
APP_VERSION_ANDROID_URL=https://play.google.com/store/apps/details?id=com.mitabl.user.mitabl_user
